# Plays Ranch MCP Connector v1 — environment inventory.
# Placeholders only. Real values live in the hosting platform's encrypted env settings.

# --- Service ---
NODE_ENV=production
PORT=8787
SERVICE_VERSION=0.1.0
# Public HTTPS URL of the MCP endpoint. Also the OAuth resource / token audience.
MCP_RESOURCE_URL=https://mcp.example.com/mcp

# --- OAuth (authorization server, e.g. Clerk) ---
# jwt = verify JWT access tokens with JWKS; introspection = RFC 7662 for opaque tokens.
OAUTH_MODE=jwt
OAUTH_ISSUER=https://your-auth-server.example.com
# Optional; defaults to MCP_RESOURCE_URL.
OAUTH_AUDIENCE=
OAUTH_REQUIRED_SCOPE=registry:read
# jwt mode
OAUTH_JWKS_URL=https://your-auth-server.example.com/.well-known/jwks.json
# introspection mode
OAUTH_INTROSPECTION_URL=
OAUTH_INTROSPECTION_CLIENT_ID=
OAUTH_INTROSPECTION_CLIENT_SECRET=
# Only set true if the authorization server's introspection response omits aud. Weakens resource binding.
OAUTH_INTROSPECTION_ALLOW_MISSING_AUD=false

# --- Registry data ---
# postgres (default) or fixture (labeled demo data; refused in production unless ALLOW_FIXTURE_IN_PRODUCTION=true)
REGISTRY_SOURCE=postgres
# Connect as the read-only plays_ranch_connector role. Never a service-role or superuser credential.
DATABASE_URL=postgres://plays_ranch_connector:CHANGE_ME@db.example.com:5432/postgres
DATABASE_SSL=true
REGISTRY_FIXTURE_PATH=fixtures/demo-registry.json
ALLOW_FIXTURE_IN_PRODUCTION=false

# --- Tests only ---
# Disposable database with owner rights; enables test/postgres.test.ts.
TEST_DATABASE_URL=

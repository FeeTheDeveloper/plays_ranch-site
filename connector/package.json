  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
